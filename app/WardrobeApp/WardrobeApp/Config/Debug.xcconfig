// Development environment values. Secrets are not defined here at all — the
// TestFlight workflow passes them to xcodebuild from GitHub Actions secrets.

// Local.xcconfig is untracked and included first, so every assignment below
// wins over it. Put per-machine values there: DEVELOPMENT_TEAM for a physical
// device, and an API_BASE_URL override for this Mac's .local hostname.
#include? "Local.xcconfig"

// `//` starts a comment in xcconfig, so every URL needs the empty-$() trick
// between the slashes — without it the value is silently truncated to "https:".
//
// On a physical device 127.0.0.1 is the phone itself, not this Mac, so the two
// SDKs point at different hosts: the simulator at the local server, the phone
// at whatever you deployed.
API_BASE_URL[sdk=iphonesimulator*] = http:/$()/127.0.0.1:8080
SENTRY_ENVIRONMENT = development
CONSENT_AI_PROVIDER = Seedream (ByteDance)
