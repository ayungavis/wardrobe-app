{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "WardrobeApp"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used to photograph your outfit for the daily challenge. Photos stay on your device until you choose to share them."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera dipakai untuk memotret outfitmu dalam tantangan harian. Foto tetap di perangkatmu sampai kamu memilih membagikannya."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Finds the development backend running on your Mac over Wi-Fi. Release builds talk to the hosted API and never use the local network."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Checks tomorrow's forecast near you so your challenge cards suit the weather. Your location never leaves your device — only a short weather summary is sent."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets you save your edited outfit photo to your photo library."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memungkinkanmu menyimpan foto outfit hasil edit ke galeri fotomu."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows your most recent photo on the gallery button so you can import an outfit photo quickly. You can still pick photos without granting this."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan foto terbarumu di tombol galeri agar impor foto outfit lebih cepat. Kamu tetap bisa memilih foto tanpa memberi izin ini."
          }
        }
      }
    }
  },
  "version" : "1.0"
}