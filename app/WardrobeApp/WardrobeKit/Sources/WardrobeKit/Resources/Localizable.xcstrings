    "consent.ai.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmed, normalized garment cut-outs may be processed by OpenRouter and %@ for attribute proposals and garment illustrations. Your canvas documents — including anything you typed or drew — are never sent to them."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cut-out pakaian yang sudah dikonfirmasi dan dinormalisasi dapat diproses oleh OpenRouter dan %@ untuk usulan atribut dan ilustrasi pakaian. Dokumen kanvasmu — termasuk apa pun yang kamu ketik atau gambar — tidak pernah dikirim ke mereka."
          }
        }
      }
    },
    "consent.ai.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI processing"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemrosesan AI"
          }
        }
      }
    },
    "consent.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up my data"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangkan dataku"
          }
        }
      }
    },
    "consent.control.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declining changes nothing on this phone: challenges, your wardrobe, and history keep working. Anything waiting to upload stays on the device."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menolak tidak mengubah apa pun di ponsel ini: tantangan, lemari pakaian, dan riwayat tetap berjalan. Apa pun yang menunggu unggah tetap tinggal di perangkat."
          }
        }
      }
    },
    "consent.control.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choice"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihanmu"
          }
        }
      }
    },
    "consent.decline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nanti saja"
          }
        }
      }
    },
    "consent.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your challenge is already saved on this phone. To restore it after a reinstall or on another device, the app can back it up to the server. Nothing uploads until you decide here."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tantanganmu sudah tersimpan di ponsel ini. Agar bisa dipulihkan setelah instal ulang atau di perangkat lain, aplikasi dapat mencadangkannya ke server. Tidak ada yang terunggah sampai kamu memutuskan di sini."
          }
        }
      }
    },
    "consent.stores.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account data; original capture and imported photos; edited derivatives; confirmed canvas documents including the text you type, sticker choices, drawing strokes, transforms, layer order, locks, and background choice; garment cut-outs; fingerprints; wear records; completions; account preferences; and generated illustrations — all kept for restore."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data akun; foto asli hasil jepretan dan impor; derivatif hasil suntingan; dokumen kanvas terkonfirmasi termasuk teks yang kamu ketik, pilihan stiker, goresan gambar, transformasi, urutan layer, kunci, dan pilihan latar; cut-out pakaian; sidik jari item; catatan pakai; penyelesaian; preferensi akun; dan ilustrasi yang dihasilkan — semuanya disimpan untuk pemulihan."
          }
        }
      }
    },
    "consent.stores.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the server stores"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang disimpan server"
          }
        }
      }
    },
    "consent.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up to the server"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangkan ke server"
          }
        }
      }
    },
