# cp .env.example .env — local development only, no production secrets here.
# Non-default port: a system PostgreSQL on 5432 is common enough that sharing it
# would be the first thing every new machine tripped over.
DATABASE_URL=postgres://wardrobe:wardrobe@localhost:5433/wardrobe

BIND_ADDR=127.0.0.1:8080

POSTGRES_USER=wardrobe
POSTGRES_PASSWORD=wardrobe
POSTGRES_DB=wardrobe
POSTGRES_PORT=5433

MINIO_ROOT_USER=wardrobe
MINIO_ROOT_PASSWORD=wardrobe-dev-secret
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# Sentry stays off when the DSN is empty, so a machine without an account does
# not spew fatal lines and CI needs no credential.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0

# S3-compatible object storage. Leave any of the four empty and the media
# endpoints report themselves unavailable while the rest of the API keeps
# serving. MinIO needs path-style addressing; R2 accepts it too.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=wardrobe
S3_ACCESS_KEY_ID=wardrobe
S3_SECRET_ACCESS_KEY=wardrobe-dev-secret
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_SECS=300

# The audience every Apple identity token must name. Leave it empty and Apple
# sign-in reports itself unavailable while anonymous sessions keep working.
APPLE_BUNDLE_ID=com.ayungavis.WardrobeApp
