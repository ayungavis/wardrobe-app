{
  "openapi": "3.1.0",
  "info": {
    "title": "Wardrobe API",
    "description": "Backend for the Wardrobe Challenge App. Session tokens are issued by the server; the client never asserts an identity of its own.",
    "license": {
      "name": "Proprietary"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness and readiness in one.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The service and its database are reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/challenges/deck": {
      "get": {
        "tags": [
          "challenge"
        ],
        "summary": "Returns the day's generated deck, or the curated catalog when none exists.",
        "operationId": "deck",
        "parameters": [
          {
            "name": "localDate",
            "in": "query",
            "description": "The user-local calendar date, computed on the device.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "The device's locale, used to pick curated copy; defaults to `en`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The day's deck",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeckResponse"
                }
              }
            }
          },
          "400": {
            "description": "Unusable query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing or unusable token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/changes": {
      "get": {
        "tags": [
          "sync"
        ],
        "summary": "Returns every record written after a cursor position, deletions included.",
        "operationId": "changes",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "description": "The last `changeSeq` you received; omit to start from the beginning.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "How many records to return, clamped to 1000.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of changes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or unusable token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/media": {
      "post": {
        "tags": [
          "media"
        ],
        "summary": "Registers an object and returns a signed URL to upload it.",
        "operationId": "reserve",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A signed upload URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GrantResponse"
                }
              }
            }
          },
          "400": {
            "description": "Unknown kind or unusable metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing or unusable token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "That id belongs to another account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Object storage is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/media/{id}": {
      "get": {
        "tags": [
          "media"
        ],
        "summary": "Returns a signed URL to download an object whose bytes have arrived.",
        "operationId": "download",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The media id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A signed download URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GrantResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or unusable token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such object, or its bytes never arrived",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Object storage is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/sessions/anonymous": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Starts or resumes an anonymous account for a device.",
        "operationId": "anonymous",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnonymousRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A session for the device's anonymous account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "The device id is not a UUID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/apple": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Verifies an Apple identity token and links it to this device's account.",
        "operationId": "apple",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A session for the Apple-backed account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "The identity token did not verify",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Apple sign-in is not configured or Apple is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/current": {
      "delete": {
        "tags": [
          "session"
        ],
        "summary": "Revokes every session in this device's family.",
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "The family is revoked; server data is untouched"
          },
          "401": {
            "description": "Missing or unusable token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/sessions/refresh": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Exchanges a refresh token for a new pair and retires the old one.",
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A rotated session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unknown, expired, revoked, or already-used refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sync": {
      "post": {
        "tags": [
          "sync"
        ],
        "summary": "Applies a batch of named mutations, each in its own transaction.",
        "operationId": "sync",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Every mutation reported individually",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            }
          },
          "400": {
            "description": "The envelope itself could not be read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing or unusable token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "More than 100 mutations, or a body past 1 MB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/users/me": {
      "delete": {
        "tags": [
          "account"
        ],
        "summary": "Removes the account: its rows, its objects, and every session it owns.",
        "operationId": "delete_me",
        "responses": {
          "204": {
            "description": "Rows and objects are gone; nothing remains to retry"
          },
          "401": {
            "description": "Missing or unusable token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Objects remain and could not be removed; retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/whoami": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "Confirms which account a session token belongs to.",
        "operationId": "whoami",
        "responses": {
          "200": {
            "description": "The session is valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoAmI"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, unknown, expired, or revoked token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountPreference": {
        "type": "object",
        "required": [
          "recentStickerIds",
          "lastTextStyle",
          "changeSeq"
        ],
        "properties": {
          "changeSeq": {
            "type": "integer",
            "format": "int64"
          },
          "deletedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastTextStyle": {
            "type": "object"
          },
          "onboardingCompletedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "recentStickerIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uploadConsentAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "ActiveChallenge": {
        "type": "object",
        "required": [
          "id",
          "cardId",
          "acceptedAt",
          "localDate",
          "timeZone",
          "changeSeq"
        ],
        "properties": {
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "cardId": {
            "type": "string",
            "format": "uuid"
          },
          "changeSeq": {
            "type": "integer",
            "format": "int64"
          },
          "deletedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "localDate": {
            "type": "string",
            "format": "date"
          },
          "photoId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "timeZone": {
            "type": "string"
          }
        }
      },
      "AnonymousRequest": {
        "type": "object",
        "required": [
          "deviceId"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "description": "The UUID the client holds in its Keychain."
          }
        }
      },
      "AppleRequest": {
        "type": "object",
        "required": [
          "deviceId",
          "identityToken",
          "nonce"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "identityToken": {
            "type": "string",
            "description": "The identity token Apple returned to the client."
          },
          "nonce": {
            "type": "string",
            "description": "The raw nonce whose SHA-256 the client sent to Apple."
          }
        }
      },
      "CanvasDocument": {
        "type": "object",
        "required": [
          "id",
          "completionId",
          "derivativeId",
          "schemaVersion",
          "mediaObjectId",
          "changeSeq"
        ],
        "properties": {
          "changeSeq": {
            "type": "integer",
            "format": "int64"
          },
          "completionId": {
            "type": "string",
            "format": "uuid"
          },
          "deletedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "derivativeId": {
            "type": "string",
            "format": "uuid"
          },
          "historyMediaObjectId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "historyStepCount": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "mediaObjectId": {
            "type": "string",
            "format": "uuid"
          },
          "schemaVersion": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ChallengeCompletion": {
        "type": "object",
        "required": [
          "id",
          "cardId",
          "localDate",
          "timeZone",
          "completedAt",
          "status",
          "changeSeq"
        ],
        "properties": {
          "cardId": {
            "type": "string",
            "format": "uuid"
          },
          "changeSeq": {
            "type": "integer",
            "format": "int64"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "currentDerivativeId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "deletedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "localDate": {
            "type": "string",
            "format": "date"
          },
          "photoId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          }
        }
      },
      "Change": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Record"
          },
          {
            "type": "object",
            "required": [
              "changeSeq"
            ],
            "properties": {
              "changeSeq": {
                "type": "integer",
                "format": "int64",
                "description": "The feed position of this record; the cursor is the last one you received."
              }
            }
          }
        ]
      },
      "ChangesResponse": {
        "type": "object",
        "description": "One page of the change feed, oldest position first.",
        "required": [
          "changes",
          "nextSince"
        ],
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Change"
            }
          },
          "nextSince": {
            "type": "integer",
            "format": "int64",
            "description": "Pass this back as `since`; it never moves past a record this page omitted."
          }
        }
      },
      "DeckCard": {
        "type": "object",
        "required": [
          "id",
          "prompt"
        ],
        "properties": {
          "bottomItemId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "prompt": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "topItemId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "DeckResponse": {
        "type": "object",
        "description": "The day's challenge cards.",
        "required": [
          "localDate",
          "source",
          "cards"
        ],
        "properties": {
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeckCard"
            }
          },
          "localDate": {
            "type": "string",
            "format": "date"
          },
          "source": {
            "type": "string",
            "description": "`generated` or `curated`; `curated` means generation was unavailable."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The single error shape every endpoint returns.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable, matchable identifier — part of the contract.",
            "example": "unauthenticated"
          },
          "message": {
            "type": "string",
            "description": "Human-readable and safe to display.",
            "example": "Authentication is required for this request."
          }
        }
      },
      "GrantResponse": {
        "type": "object",
        "description": "A short-lived grant to move bytes, never an identity to store.",
        "required": [
          "mediaId",
          "url",
          "expiresAt"
        ],
        "properties": {
          "byteSize": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "mediaId": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "`ok` when the process is up and the database answers.",
            "example": "ok"
          }
        }
      },
      "ItemCutout": {
        "type": "object",
        "required": [
          "id",
          "itemId",
          "mediaObjectId",
          "changeSeq"
        ],
        "properties": {
          "changeSeq": {
            "type": "integer",
            "format": "int64"
          },
          "deletedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "itemId": {
            "type": "string",
            "format": "uuid"
          },
          "mediaObjectId": {
            "type": "string",
            "format": "uuid"
          },
          "sourcePhotoId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "ItemFingerprint": {
        "type": "object",
        "required": [
          "id",
          "itemId",
          "version",
          "colorLab",
          "aspectRatio",
          "featurePrint",
          "maskQuality",
          "changeSeq"
        ],
        "properties": {
          "aspectRatio": {
            "type": "number",
            "format": "float"
          },
          "changeSeq": {
            "type": "integer",
            "format": "int64"
          },
          "colorLab": {
            "type": "array",
