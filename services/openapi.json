{
  "openapi": "3.1.0",
  "info": {
    "title": "Wardrobe API",
    "description": "Backend for the Wardrobe Challenge App. Session tokens are issued by the server; the client never asserts an identity of its own.",
    "license": {
      "name": "Proprietary"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness and readiness in one.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The service and its database are reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/anonymous": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Starts or resumes an anonymous account for a device.",
        "operationId": "anonymous",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnonymousRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A session for the device's anonymous account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "The device id is not a UUID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/apple": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Verifies an Apple identity token and links it to this device's account.",
        "operationId": "apple",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A session for the Apple-backed account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "The identity token did not verify",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "This device holds data for another account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Apple sign-in is not configured or Apple is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/current": {
      "delete": {
        "tags": [
          "session"
        ],
        "summary": "Revokes every session in this device's family.",
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "The family is revoked; server data is untouched"
          },
          "401": {
            "description": "Missing or unusable token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/v1/sessions/refresh": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Exchanges a refresh token for a new pair and retires the old one.",
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A rotated session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unknown, expired, revoked, or already-used refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/whoami": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "Confirms which account a session token belongs to.",
        "operationId": "whoami",
        "responses": {
          "200": {
            "description": "The session is valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoAmI"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, unknown, expired, or revoked token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AnonymousRequest": {
        "type": "object",
        "required": [
          "deviceId"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid",
            "description": "The UUID the client holds in its Keychain."
          }
        }
      },
      "AppleRequest": {
        "type": "object",
        "required": [
          "deviceId",
          "identityToken",
          "nonce"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "identityToken": {
            "type": "string",
            "description": "The identity token Apple returned to the client."
          },
          "nonce": {
            "type": "string",
            "description": "The raw nonce whose SHA-256 the client sent to Apple."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The single error shape every endpoint returns.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable, matchable identifier — part of the contract.",
            "example": "unauthenticated"
          },
          "message": {
            "type": "string",
            "description": "Human-readable and safe to display.",
            "example": "Authentication is required for this request."
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "`ok` when the process is up and the database answers.",
            "example": "ok"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The refresh token from the previous session response."
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "description": "A newly issued session.",
        "required": [
          "accountId",
          "accessToken",
          "refreshToken",
          "expiresAt",
          "refreshExpiresAt"
        ],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Returned exactly once; only its hash is stored."
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "WhoAmI": {
        "type": "object",
        "required": [
          "accountId",
          "sessionId"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid",
            "description": "The account this session belongs to."
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer",
        "description": "Session token from POST /v1/sessions/*. Sent as `Authorization: Bearer <token>`."
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and readiness"
    },
    {
      "name": "session",
      "description": "Session lifecycle and identity"
    }
  ]
}
